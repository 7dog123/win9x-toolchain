# Dockerfile for Canadian Cross build
# Builds a complete Win9x-hosted toolchain (runs on Win9x, targets Win9x)

FROM debian:stretch

ENV DEBIAN_FRONTEND=noninteractive

# Debian 9 (stretch) is EOL - use archive.debian.org
RUN sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' /etc/apt/sources.list && \
    sed -i 's|http://security.debian.org/debian-security|http://archive.debian.org/debian-security|g' /etc/apt/sources.list && \
    sed -i '/stretch-updates/d' /etc/apt/sources.list && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget curl ca-certificates \
    xz-utils bzip2 gzip tar \
    make gcc g++ binutils \
    flex bison texinfo gawk patch diffutils file \
    libgmp-dev libmpfr-dev libmpc-dev libisl-dev \
    zlib1g-dev \
    libtool autoconf automake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY versions-canadian.txt fetch-canadian.sh build-canadian.sh mingw-fixed /workspace/mingw-fixed/

RUN chmod +x fetch-canadian.sh build-canadian.sh

# Default: fetch and build everything
CMD ["./fetch-canadian.sh && ./build-canadian.sh all"]